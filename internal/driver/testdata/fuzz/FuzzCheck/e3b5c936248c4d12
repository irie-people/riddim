[]byte("// Parse: Result, Option, ? and parse_int.\n\n/// Parses e\x00\x00\x00\x00 text as an Int, stopping at the first that is not one.\nfn parse_all(texts: List<String>) -> Result<List<Int>, Error> {\n    let mut out: List<Int> = []\n    for t in texts {\n        let n = t.parse_int().map_err(|e| e.context(\"reading the list\"))?\n        out = out.push(n)\n    }\n    Ok(out)\n}\n\nfn sum(texts: List<String>) -> Result<Int, Error> {\n    let nums = parse_all(texts)?\n    Ok(nums.fold(0, |acc, n| acc + n))\n}\n\n/// The first even number, if any.\nfn first_even(nums: List<Int>) -> Option<Int> {\n    let evens = nums.filter(|n| n % 2 == 0)\n    evens.get(0)\n}\n\nfn half_of_first_even(nums: List<Int>) -> Option<Int> {\n    let n = first_even(nums)?\n    Some(n / 2)\n}\n\nfn check_age(text: String) -> Result<Int, Error> {\n    let age = text.parse_int()?\n    if age < 0 {\n        return Err(error(\"age cannot be negative: \" + age.to_string()))\n    }\n    Ok(age)\n}\n\nfn report(sys: Sys, label: String, r: Result<Int, Error>) {\n    match r {\n        Ok(n) => sys.out.println(label + \": \" + n.to_string()),\n        Err(e) => sys.out.println(label + \" failed: \" + e.message()),\n    }\n}\n\nfn main(sys: Sys) -> Result<(), Error> {\n    report(sys, \"sum\", sum([\"1\", \"2\", \"39\"]))\n    report(sys, \"bad sum\", sum([\"7\", \"x8\"]))\n    report(sys, \"age\", check_age(\"42\"))\n    report(sys, \"negative age\", check_age(\"-3\"))\n\n    let nums = parse_all([\"3\", \"10\", \"4\"])?\n    match half_of_first_even(nums) {\n        Some(h) => sys.out.println(\"half of the first even: \" + h.to_string()),\n        None => sys.out.println(\"no even number\"),\n    }\n    let none = half_of_first_even([1, 3])\n    sys.out.println(\"odd only: \" + none.map(|h| h.to_string()).unwrap_or(\"nothing\"))\n\n    let total = sum([\"5\", \"five\"]).map_err(|e| e.context(\"adding the totals\"))?\n    sys.out.println(\"unreachable: \" + total.to_string())\n    Ok(())\n}\n")
