// Int and Float methods (DESIGN §4.9).

fn main(sys: Sys) {
    let n = -7
    sys.out.println("${n.abs()} ${7.abs()} ${n.min(3)} ${n.max(3)} ${5.min(5)}")
    let smallest = -9223372036854775807 - 1
    sys.out.println("${smallest.abs()}")
    let f = -2.5
    sys.out.println("${f.abs()} ${f.floor()} ${f.ceil()} ${f.round()} ${2.5.round()} ${0.49.round()}")
    sys.out.println("${16.0.sqrt()} ${2.0.sqrt()} ${(-1.0).sqrt()}")
    let big = 1e300
    sys.out.println("${(big * big).floor()} ${(big * big * 0.0).round()}")
}
