fn describe(n: Int) -> String {
    match n {
        0 => "zero",
        1 | 2 | 3 => "small",
        -1 => "minus one",
        x if x < 0 => "negative",
        _ => "large",
    }
}

fn kind(s: String) -> Int {
    match s {
        "a" => 1,
        "b" | "c" => 2,
        _ => 0,
    }
}

fn classify(r: Result<Option<Int>, String>) -> String {
    match r {
        Ok(Some(n)) if n > 0 => "positive " + n.to_string(),
        Ok(Some(n)) => "not positive " + n.to_string(),
        Ok(None) => "missing",
        Err(e) => "error " + e,
    }
}

enum Shape {
    Circle(Float),
    Square(Float),
    Rect(Float, Float),
}

fn side(s: Shape) -> Float {
    match s {
        Circle(x) | Square(x) => x,
        Rect(w, _) => w,
    }
}

fn main(sys: Sys) {
    for n in [0, 2, -1, -7, 42] {
        sys.out.println(describe(n))
    }
    sys.out.println((kind("a") + kind("c") * 10 + kind("z") * 100).to_string())
    sys.out.println(classify(Ok(Some(5))))
    sys.out.println(classify(Ok(Some(-5))))
    sys.out.println(classify(Ok(None)))
    sys.out.println(classify(Err("bad")))
    sys.out.println((side(Shape::Circle(1.5)) + side(Shape::Square(2.0)) + side(Shape::Rect(3.0, 4.0))).to_string())
    let flag = true
    let word = match flag {
        true => "yes",
        false => "no",
    }
    sys.out.println(word)
    match (1, "b") {
        (1, "a") => sys.out.println("1a"),
        (1, w) => sys.out.println("1" + w),
        _ => sys.out.println("other"),
    }
    let shapes = [Shape::Rect(1.0, 2.0), Shape::Circle(3.0)]
    for s in shapes {
        let what = match s {
            Rect(w, h) if w == h => "square rect",
            Rect(_, _) => "rect",
            _ => "round or square",
        }
        sys.out.println(what)
    }
}
